# EMWM-Motif - Openbox theme imitating EMWM/Motif decorations
# Used by "applixware --xephyr" (own rc.xml in $AX_BASE/openbox/rc.xml).
# Part of applixware-wrapper. SPDX-License-Identifier: GPL-3.0-or-later
#
# Active colours derive from X11 "cyan4" (#008b8b) by Motif's own rule
# (XmCalculateColorsRGB): top shadow #89c9c9, bottom shadow #004242, white text.
# Openbox bevels multiply the base colour instead of blending towards white,
# so the light edge can only get Motif's green/blue (#00c9c9; red stays 0).
# Active:   base #008b8b  light #89c9c9  shadow #004242
# Inactive: base #8c8c8c  light #cccccc  shadow #474747
# Button layout: D (Motif menu bar; rebound to the window menu in rc.xml) L I M
# "I" uses an OS/2 Warp 3 style hide glyph (corners of an 8x8 square) rather
# than Motif's minimize dot: Openbox has no root-window icons to minimize into.

border.width: 1
padding.width: 3
padding.height: 2
window.label.text.justify: center
window.handle.width: 5
window.client.padding.width: 4
window.client.padding.height: 4

# ---- active window ----------------------------------------------------
window.active.border.color: #004242
window.active.title.separator.color: #004242
window.active.client.color: #008b8b

window.active.title.bg: flat solid
window.active.title.bg.color: #008b8b

window.active.label.bg: raised solid bevel1
window.active.label.bg.color: #008b8b
window.active.label.text.color: #ffffff
window.active.label.text.font: shadow=n

window.active.handle.bg: raised solid bevel1
window.active.handle.bg.color: #008b8b
window.active.grip.bg: raised solid bevel1
window.active.grip.bg.color: #008b8b

window.active.button.unpressed.bg: raised solid bevel1
window.active.button.unpressed.bg.color: #008b8b
window.active.button.unpressed.image.color: #ffffff
window.active.button.hover.bg: raised solid bevel1
window.active.button.hover.bg.color: #008b8b
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: sunken solid bevel1
window.active.button.pressed.bg.color: #008b8b
window.active.button.pressed.image.color: #ffffff
window.active.button.toggled.unpressed.bg: raised solid bevel1
window.active.button.toggled.unpressed.bg.color: #008b8b
window.active.button.toggled.unpressed.image.color: #ffffff
window.active.button.toggled.pressed.bg: sunken solid bevel1
window.active.button.toggled.pressed.bg.color: #008b8b
window.active.button.toggled.pressed.image.color: #ffffff
window.active.button.toggled.hover.bg: raised solid bevel1
window.active.button.toggled.hover.bg.color: #008b8b
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.disabled.bg: raised solid bevel1
window.active.button.disabled.bg.color: #008b8b
window.active.button.disabled.image.color: #45aaaa

# bevel edges calibrated to the Motif colours above
window.active.label.bg.highlight: 115
window.active.label.bg.shadow: 134
window.active.handle.bg.highlight: 115
window.active.handle.bg.shadow: 134
window.active.grip.bg.highlight: 115
window.active.grip.bg.shadow: 134
window.active.button.unpressed.bg.highlight: 115
window.active.button.unpressed.bg.shadow: 134
window.active.button.hover.bg.highlight: 115
window.active.button.hover.bg.shadow: 134
window.active.button.pressed.bg.highlight: 115
window.active.button.pressed.bg.shadow: 134
window.active.button.toggled.unpressed.bg.highlight: 115
window.active.button.toggled.unpressed.bg.shadow: 134
window.active.button.toggled.pressed.bg.highlight: 115
window.active.button.toggled.pressed.bg.shadow: 134
window.active.button.toggled.hover.bg.highlight: 115
window.active.button.toggled.hover.bg.shadow: 134
window.active.button.disabled.bg.highlight: 115
window.active.button.disabled.bg.shadow: 134

